{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDRE",
  "version": "0.2.0",
  "identifier": "local.mdre.prototype",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDRE",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": false
  }
}
